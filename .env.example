# ---------------------------------------------------------------------------
# AmbiSense - environment variables
# Copy this file to `.env` and fill in your key.  `.env` is git-ignored.
# ---------------------------------------------------------------------------

# API key for the provider selected in config/config.yaml (llm.provider).
# Groq  (default) -> https://console.groq.com/keys      (free tier)
# OpenAI          -> https://platform.openai.com/api-keys
# Anthropic       -> https://console.anthropic.com/settings/keys
# Gemini          -> https://aistudio.google.com/app/apikey
LLM_API_KEY=your_api_key_here

# Optional: override the provider / model chosen in config.yaml without
# editing the YAML file (useful for quick demos).
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: logging verbosity (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
