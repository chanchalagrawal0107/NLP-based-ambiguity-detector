# ---------------------------------------------------------------------------
# AmbiSense - environment variables
# Copy this file to `.env` if you want to override anything. `.env` is
# git-ignored. EVERY variable here is optional: the defaults in
# config/config.yaml work with a local Ollama server out of the box.
# ---------------------------------------------------------------------------

# Switch the local Ollama model for a run without editing config.yaml.
# The model must be installed first:  ollama pull <model>
# LLM_MODEL=qwen2.5:latest

# Point at an Ollama server that is not on this machine's default port.
# LLM_BASE_URL=http://localhost:11434/v1

# Only if your Ollama server sits behind an authenticating reverse proxy.
# A normal local Ollama server needs no key.
# LLM_API_KEY=

# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
